{
  "name": "flowser",
  "description": "Flowser - A browser extension for automating web workflows with AI",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog": "git-cliff -o CHANGELOG.md"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/deepseek": "^3.0.88",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/openai": "^4.0.121",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@lucide/vue": "^1.74.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/vue-table": "^9.3.1",
    "@thesvg/vue": "^4.0.12",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-js-cron/light": "^5.2.3",
    "@vueuse/core": "^15.0.0",
    "ai": "^7.0.176",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "cron-parser": "^5.10.6",
    "idb": "^8.0.4",
    "quickjs-emscripten": "^0.32.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45",
    "vue-codemirror": "^6.1.1",
    "vue-i18n": "^11.4.22",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "git-cliff": "^2.14.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "lint-staged": {
    "*.{js,mjs,jsx,ts,tsx,vue}": "eslint --fix"
  }
