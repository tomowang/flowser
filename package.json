    "@thesvg/vue": "^3.2.20",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-js-cron/light": "^5.1.1",
    "@vueuse/core": "^14.3.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "cron-parser": "^5.6.0",
    "idb": "^8.0.3",
    "quickjs-emscripten": "^0.32.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
